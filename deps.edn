{:paths ["src"]

 :deps
 {org.clojure/clojure         {:mvn/version "1.12.0"}
  ring/ring-core              {:mvn/version "1.12.2"}
  ring/ring-jetty-adapter     {:mvn/version "1.12.2"}
  ring/ring-json              {:mvn/version "0.5.1"}
  integrant/integrant         {:mvn/version "0.13.1"}
  compojure/compojure         {:mvn/version "1.7.1"}
  com.draines/postal          {:mvn/version "2.0.5"}
  ring-cors/ring-cors         {:mvn/version "0.1.13"}
  clj-http/clj-http           {:mvn/version "3.13.0"}
  cheshire/cheshire           {:mvn/version "5.13.0"}
  hickory/hickory             {:mvn/version "0.7.1"}
  etaoin/etaoin               {:mvn/version "1.1.43"}
  org.clojure/tools.logging   {:mvn/version "1.3.0"}
  org.slf4j/slf4j-simple      {:mvn/version "2.0.13"}
  nrepl/nrepl                 {:mvn/version "1.3.1"}
  jarohen/chime               {:mvn/version "0.3.3"}
  clojure.java-time/clojure.java-time {:mvn/version "1.4.3"}}

 :aliases
 {; Start web server only (port 3000). No Chrome, no scraper. clj -M:run
  :run          {:main-opts ["-m" "web-compose.core"]}

  ; Interactive REPL for local development. Includes ring-devel for hot reload. clj -M:dev
  :dev          {:extra-paths ["dev"]
                 :extra-deps  {ring/ring-devel {:mvn/version "1.12.2"}
                               djblue/portal {:mvn/version "0.64.1"}
                               org.clojure/data.csv {:mvn/version "1.1.1"}
                               }}

  ; Start a headless nREPL server on port 7888. Connect your editor to localhost:7888. clj -M:nrepl
  :nrepl        {:main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}

  ; TODO REMOVE Start everything: web server + headless Chrome + scraper scheduler + nREPL. Used by Docker. clj -M:scraper-repl
  :scraper-repl {:main-opts ["-m" "web-compose.scrape-obrrtni-registar.docker-repl"]}

  ; run tests
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}

  }
 }
